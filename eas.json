{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview-noads": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_DISABLE_ADS": "true"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-noads": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_DISABLE_ADS": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}